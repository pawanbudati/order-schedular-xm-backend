# Server Port
PORT=8444

# Admin Authentication Passcode
ADMIN_PASSWORD=1234

# Local MT5 Python Bridge Service URL
LOCAL_MT5_BRIDGE_URL=http://127.0.0.1:8555

# ==============================================================================
# MULTIPLE MT5 INSTANCES TERMINAL PATHS & CUSTOM NAMES CONFIGURATION
# ==============================================================================
# Specify the paths to terminal64.exe and optional custom display names for each MT5 instance.
# These custom names will be displayed in the UI account selection dropdowns and order cards.

# Option A: Individual Indexed Paths & Custom Display Names (Recommended)
MT5_PATH_1="C:\apps\mt5-instances\real-long-01\terminal64.exe"
MT5_NAME_1="Main Scalper Account"

MT5_PATH_2="C:\apps\mt5-instances\real-long-02\terminal64.exe"
MT5_NAME_2="Swing Gold Strategy"

MT5_PATH_3="C:\apps\mt5-instances\real-long-03\terminal64.exe"
MT5_NAME_3="High Leverage Account"

# Option B: Comma-Separated Paths & Display Names List
# MT5_TERMINAL_PATHS="C:\Program Files\XM MetaTrader 5\terminal64.exe, C:\Program Files\XM Global MT5 2\terminal64.exe"
# MT5_TERMINAL_NAMES="Main Scalper Account, Swing Gold Strategy"

# Option C: Single Default Terminal Path & Name
# MT5_PATH="C:\Program Files\MetaTrader 5\terminal64.exe"
# MT5_NAME="Primary MT5 Trading Account"




