# Server Port
PORT=8444

# Admin Authentication Passcode
ADMIN_PASSWORD=1234

# Local MT5 Python Bridge Service URL
LOCAL_MT5_BRIDGE_URL=http://127.0.0.1:8555

# ==============================================================================
# MULTIPLE MT5 INSTANCES TERMINAL PATHS CONFIGURATION
# ==============================================================================
# Specify the paths to terminal64.exe for each MT5 instance running on Windows.
# The bridge automatically scans these paths and detects logged-in MT5 accounts.
#
# Option A: Individual Indexed Paths (Recommended)
MT5_PATH_1="C:\Program Files\XM MetaTrader 5\terminal64.exe"
MT5_PATH_2="C:\Program Files\XM Global MT5 2\terminal64.exe"
MT5_PATH_3="C:\Program Files\MetaTrader 5 Account 3\terminal64.exe"

# Option B: Comma-Separated Terminal Paths List
# MT5_TERMINAL_PATHS="C:\Program Files\XM MetaTrader 5\terminal64.exe, C:\Program Files\XM Global MT5 2\terminal64.exe"

# Option C: Single Default Terminal Path
# MT5_PATH="C:\Program Files\MetaTrader 5\terminal64.exe"



